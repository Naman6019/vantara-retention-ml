# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data files (keep folder structure with .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts (large/derived ones are regenerated by the pipeline; the small
# deployed serving artifacts and the model card are committed so the repo runs
# end-to-end and CI can exercise the real API + batch scorer).
models_artifacts/*
!models_artifacts/.gitkeep
!models_artifacts/model_card.json
!models_artifacts/churn_best_model.joblib
!models_artifacts/clv_best_model.joblib
!models_artifacts/churn_calibrator.joblib
!models_artifacts/scaler.joblib
!models_artifacts/kmeans_model.joblib
!models_artifacts/segmentation_scaler.joblib
!models_artifacts/segment_personas.joblib
!models_artifacts/reference_distribution.json
!models_artifacts/engagement_reference.json
!models_artifacts/probabilistic_clv.json
!models_artifacts/probabilistic_clv_benchmark.json
!models_artifacts/churn_model_comparison.csv
!models_artifacts/clv_model_comparison.csv
!models_artifacts/five_fold_cv.csv
!models_artifacts/test_confusion.json
!models_artifacts/product_recommender.joblib
!models_artifacts/product_recommender_metrics.json

# MLflow experiment tracking (local file store)
mlruns/
mlartifacts/
.mlflow/

# DVC
.dvc/
*.dvc.lock
.dvcignore

# uv
uv.lock.orig

# Env files
.env
.env.local

# Environments & Virtual Envs
.venv/
env/
venv/
ENV/
*.env
.env.*
!/.env.example

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/

# Logs
logs/*
!logs/.gitkeep
*.log

# OS generated files
.DS_Store
Thumbs.db

# Node / React prototype build output
frontend-crm/node_modules/
frontend-crm/dist/
frontend-crm/.vite/

# Ruff / mypy caches
.ruff_cache/
.mypy_cache/

# Local SQLite fallback DB
vantara.db

