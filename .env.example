# Vantara local environment (copy to .env and adjust). Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=vantara_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=vantara_retail
DATABASE_URL=postgresql://vantara_user:change_me_locally@db:5432/vantara_retail

# --- API / Dashboard ---
API_URL=http://api:8000
LOG_LEVEL=INFO

# --- MLflow (optional) ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_ALLOW_FILE_STORE=true
